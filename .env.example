# Aiven PostgreSQL (priorité 1 – première option testée). Serveur uniquement.
# URI ex. postgres://user:pass@host:port/defaultdb?sslmode=require. Vercel : AIVEN_DATABASE_URL ou shvb_AIVEN_DATABASE_URL
# AIVEN_DATABASE_URL=
#
# Neon PostgreSQL (priorité 3). Serveur uniquement. shvb_DATABASE_URL ou DATABASE_URL
# shvb_DATABASE_URL=
# DATABASE_URL=

# Convex (priorité 2 – testé si Aiven échoue)
# URL du déploiement pour le client frontend (ex. https://xxx.convex.cloud)
# VITE_CONVEX_URL=

# Optionnel : base URL de l'API en dev (ex. http://localhost:3000 si API sur un autre port)
# VITE_API_URL=

# Appwrite (optionnel)
# VITE_APPWRITE_ENDPOINT=
# VITE_APPWRITE_PROJECT_ID=
# VITE_APPWRITE_DATABASE_ID=
# VITE_APPWRITE_COLLECTION_TEAMS=
# VITE_APPWRITE_COLLECTION_SETTINGS=

# Supabase (optionnel)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
