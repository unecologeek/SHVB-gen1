# Neon PostgreSQL (serveur uniquement – ne pas préfixer par VITE_)
# Utiliser l’URL pooled pour le serverless (Vercel).
# Priorité : shvb_DATABASE_URL (Vercel avec préfixe), puis DATABASE_URL (local ou sans préfixe).
# shvb_DATABASE_URL=
# DATABASE_URL=
# Référence autres variables Neon préfixées (non utilisées par l’API) : shvb_POSTGRES_URL, shvb_POSTGRES_PASSWORD, shvb_POSTGRES_USER, shvb_DATABASE_URL_UNPOOLED, shvb_POSTGRES_PRISMA_URL, shvb_POSTGRES_DATABASE, shvb_NEON_PROJECT_ID, shvb_PGUSER, shvb_PGPASSWORD

# Optionnel : base URL de l’API en dev (ex. http://localhost:3000 si API sur un autre port)
# VITE_API_URL=

# Appwrite (optionnel)
# VITE_APPWRITE_ENDPOINT=
# VITE_APPWRITE_PROJECT_ID=
# VITE_APPWRITE_DATABASE_ID=
# VITE_APPWRITE_COLLECTION_TEAMS=
# VITE_APPWRITE_COLLECTION_SETTINGS=

# Supabase (optionnel)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
